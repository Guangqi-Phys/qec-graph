            "properties": {
              "event": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "denominator": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rounds": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "boundaries": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "postselection": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeout_policy": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
