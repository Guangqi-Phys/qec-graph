            ],
            "properties": {
              "construction_kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "input_revisions": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "formula": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conventions": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "classical_code"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "field",
              "check_matrix_id",
              "n",
              "rank",
              "dimension",
              "distance_estimate_ids"
            ],
            "properties": {
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "check_matrix_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "dimension": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "distance_estimate_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "quantum_code"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "construction_id",
              "fixed_inputs",
              "parameters",
              "check_matrix_ids",
              "distance_estimate_ids"
            ],
            "properties": {
              "construction_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fixed_inputs": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "parameters": {
                "type": "object",
                "required": [
                  "n",
                  "k"
                ],
                "properties": {
                  "n": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "k": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              },
              "check_matrix_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "distance_estimate_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "check_matrix"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "instance_id",
              "matrices",
              "row_order",
              "qubit_order",
              "matrix_definition_id",
              "index_base"
            ],
            "properties": {
              "instance_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matrices": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "row_order": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qubit_order": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matrix_definition_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "index_base": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "repository",
              "commit",
              "entry",
              "configuration",
              "dependency_lock",
              "platform"
            ],
            "properties": {
              "repository": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "configuration": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "dependency_lock": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "platform": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "evidence_kind",
              "method",
              "inputs",
              "checker",
              "outputs",
              "scope",
              "limitations"
            ],
            "properties": {
              "evidence_kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inputs": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "checker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "outputs": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "limitations": {
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "formalization"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "claim_id",
              "lean_declaration",
              "build_evidence_id",
              "semantic_review",
              "proof_progress"
            ],
            "properties": {
              "claim_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lean_declaration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "build_evidence_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "semantic_review": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proof_progress": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "circuit"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "check_matrix_id",
              "schedule",
              "ancillas",
              "rounds",
