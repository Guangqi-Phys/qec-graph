            ],
            "properties": {
              "input_revisions": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "configuration": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "sampling": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "metric": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "statistics": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "environment": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "metric"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "event",
              "denominator",
              "sector",
              "rounds",
              "boundaries",
              "postselection",
