                ]
              },
              "schedule": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ancillas": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "rounds": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "boundaries": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observables": {
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "noise"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "model",
              "channels",
              "placement",
              "probability_meaning"
            ],
            "properties": {
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channels": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "placement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "probability_meaning": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decoder"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "algorithm",
              "version",
              "configuration"
            ],
            "properties": {
              "algorithm": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "configuration": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
