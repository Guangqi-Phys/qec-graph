    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "asset"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "uri",
              "sha256",
              "media_type",
              "size_bytes"
            ],
            "properties": {
              "uri": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "claim"
          },
          "data": {
            "required": [
              "relation"
            ],
            "properties": {
              "relation": {
                "enum": [
                  "exact",
                  "lower_bound",
                  "upper_bound",
                  "interval"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "subject_id",
              "check_matrix_id",
              "metric_id",
              "sector",
              "method",
              "assumptions",
              "lower_bound",
              "upper_bound"
            ],
            "properties": {
              "subject_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "check_matrix_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metric_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sector": {
                "enum": [
                  "X",
                  "Z",
                  "joint",
                  null
                ]
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assumptions": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "lower_bound": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "upper_bound": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lean_declaration"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "declaration_name",
              "module",
              "type",
              "type_expr_sha256",
              "build_evidence_id",
              "build_id",
              "proof_progress",
              "axiom_audit",
              "semantic_review"
            ],
            "properties": {
              "declaration_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
