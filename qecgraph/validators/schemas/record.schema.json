{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qec-graph.local/schemas/record.schema.json",
  "title": "Revisioned authoritative QEC record, not an extracted block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "revision",
    "title",
    "data",
    "aliases",
    "refs",
    "assets",
    "provenance",
    "review",
    "evidence_ids",
    "extensions",
    "hash_protocol",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "qecgraph.record"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "source_work",
        "source_version",
        "definition",
        "claim",
        "family",
        "construction",
        "classical_code",
        "quantum_code",
        "check_matrix",
        "implementation",
        "evidence",
        "formalization",
        "circuit",
        "noise",
        "decoder",
        "experiment",
        "metric",
        "asset",
        "lean_declaration"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "declared",
              "candidate",
              "stale",
              "unbound_review",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "uri",
          "path",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "pattern": "^qecasset:sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          },
          "original_path": {
            "type": "string"
          },
          "legacy_canonical_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "legacy_hash_protocol": {
            "const": "sha256:json-sort-ascii-v1"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "draft",
            "imported",
            "reviewed",
            "disputed",
            "stale"
          ]
        },
        "review_id": {
          "type": "string",
          "pattern": "^review:"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "required": [
              "review_id",
              "review_sha256"
            ]
          }
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    },
    "hash_protocol": {
      "const": "sha256:json-sort-utf8-v1:record-excluding-content_sha256"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_work"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "external_ids",
              "availability"
            ],
            "properties": {
              "external_ids": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "availability": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_version"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "work_id",
              "upstream_version",
              "asset_manifest",
              "availability"
            ],
            "properties": {
              "work_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "upstream_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "asset_manifest": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "availability": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "definition"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "statement",
              "scope"
            ],
            "properties": {
              "statement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "claim"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "statement",
              "hypotheses",
              "quantifiers"
            ],
            "properties": {
              "statement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hypotheses": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "quantifiers": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "family"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "description",
              "construction_class",
              "base_field"
            ],
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "construction_class": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_field": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "construction"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "construction_kind",
              "input_revisions",
