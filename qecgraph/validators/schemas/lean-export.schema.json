{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "exporter_version", "lean_version", "declarations", "driver_imports", "imported_modules", "environment_trust_level", "dependency_semantics", "axiom_method", "type_expr_protocol"],
  "properties": {
    "schema": {"const": "qecgraph.lean-export"},
    "exporter_version": {"const": "lean-environment-v1"},
    "lean_version": {"type": "string"},
    "driver_imports": {"type": "array"},
    "imported_modules": {"type": "array", "items": {"type": "string"}},
    "environment_trust_level": {"type": "integer", "minimum": 0},
    "dependency_semantics": {"type": "string"},
    "axiom_method": {"type": "string"},
    "type_expr_protocol": {"type": "string"},
    "declarations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "namespace", "kind", "module", "imports", "source_range", "universe_parameters", "type", "type_expr", "type_has_metavariables", "value", "type_constants_direct", "proof_constants_direct", "type_constants_transitive", "proof_constants_transitive", "axioms_transitive", "dependencies_filtered"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "namespace": {"type": "string"},
          "kind": {"enum": ["theorem", "definition", "opaque", "axiom", "inductive", "constructor", "recursor", "quotient"]},
          "module": {"type": "string", "minLength": 1},
          "imports": {"type": "array"},
          "source_range": {"type": ["object", "null"]},
          "universe_parameters": {"type": "array", "items": {"type": "string"}},
          "type": {"type": "string", "minLength": 1},
          "type_expr": {"type": "object"},
          "type_has_metavariables": {"type": "boolean"},
          "value": {"type": ["string", "null"]},
          "type_constants_direct": {"type": "array", "items": {"type": "string"}},
          "proof_constants_direct": {"type": "array", "items": {"type": "string"}},
          "type_constants_transitive": {"type": "array", "items": {"type": "string"}},
          "proof_constants_transitive": {"type": "array", "items": {"type": "string"}},
          "axioms_transitive": {"type": "array", "items": {"type": "string"}},
          "dependencies_filtered": {"type": "boolean"}
        }
      }
    }
  }
}
