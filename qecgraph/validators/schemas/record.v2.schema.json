{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qec-graph.local/schemas/record.v2.schema.json",
  "title": "Revisioned authoritative QEC record, not an extracted block",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "revision", "title", "data", "aliases", "refs", "assets", "provenance", "review", "evidence_ids", "extensions", "hash_protocol", "content_sha256"],
  "properties": {
    "schema_version": {"const": "qecgraph.record.v2"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["source_work", "source_version", "definition", "claim", "family", "construction", "classical_seed", "code_instance", "presentation", "implementation", "evidence", "formalization", "circuit", "noise", "decoder", "experiment", "metric", "asset"]},
    "revision": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "data": {"type": "object"},
    "refs": {"type": "array", "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "review": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["proposed", "draft", "imported", "reviewed", "disputed", "stale"]}}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"},
    "hash_protocol": {"const": "sha256:json-sort-utf8-v1:record-excluding-content_sha256"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
