{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "proposal_id",
    "proposal_sha256",
    "corpus_id",
    "actor",
    "decision",
    "status",
    "checked_scopes",
    "rationale",
    "created_at",
    "input_bindings",
    "scope"
  ],
  "properties": {
    "schema": {
      "const": "qecgraph.review"
    },
    "id": {
      "type": "string",
      "pattern": "^review:"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal:[0-9a-f]{64}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "corpus_id": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "ai",
            "program"
          ]
        }
      }
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "status": {
      "enum": [
        "human_approved",
        "machine_accepted",
        "rejected"
      ]
    },
    "checked_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "statement",
          "hypotheses",
          "dependencies"
        ]
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "input_bindings": {
      "type": "object"
    },
    "scope": {
      "type": "string"
    }
  }
}
