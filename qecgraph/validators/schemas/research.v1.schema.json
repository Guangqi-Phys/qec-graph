{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qec-graph.local/schemas/research.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "kind", "data", "field_evidence", "is_synthetic"],
  "properties": {
    "schema_version": {"const": "qecgraph.research.v1"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "algorithm",
        "catalog_source",
        "circuit_protocol",
        "classical_seed",
        "code_family",
        "code_instance",
        "code_mention",
        "code_presentation",
        "construction",
        "decoder_configuration",
        "distance_claim",
        "execution_environment",
        "execution_run",
        "hardware_assumptions",
        "metric_definition",
        "noise_instantiation",
        "noise_model",
        "paper_version",
        "performance_point",
        "performance_series",
        "reported_experiment",
        "software_catalog_observation",
        "software_distribution",
        "software_project",
        "software_release",
        "software_usage"
      ]
    },
    "data": {"type": "object", "properties": {"review_status": {"enum": [null, "proposed", "unreviewed"]}}},
    "is_synthetic": {"type": "boolean"},
    "field_evidence": {
      "type": "object",
      "propertyNames": {"pattern": "^/data/(?:[^~]|~[01])*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["known", "not_extracted", "unresolved", "not_reported", "not_applicable", "conflicting"]
          },
          "method": {"type": "string", "minLength": 1},
          "source_ref": {"$ref": "#/$defs/ref"},
          "source_locator": {"type": "object"},
          "reason": {"type": "string", "minLength": 1},
          "limitation": {"type": "string"},
          "checked_scope": {"type": "string", "minLength": 1},
          "checked_at": {"type": "string", "format": "date"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "known"}}},
            "then": {"required": ["source_ref", "method"]}
          },
          {
            "if": {"properties": {"status": {"enum": ["not_reported", "not_applicable", "conflicting"]}}},
            "then": {"required": ["reason"]}
          },
          {
            "if": {"properties": {"status": {"const": "not_reported"}}},
            "then": {"required": ["source_ref", "checked_scope", "checked_at"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "revision": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "nullable_refs": {"type": ["array", "null"], "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true},
    "record_data": {
      "$defs": {
        "algorithm": {},
        "catalog_source": {},
        "circuit_protocol": {
          "properties": {
            "presentation_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["code_presentation"]},
            "depth_metrics": {"type": ["array", "null"], "items": {"$ref": "#/$defs/depth_metric"}},
            "circuit_asset_ref": {"$ref": "#/$defs/nullable_managed_asset", "x-qec-managed-asset": "single"}
          }
        },
        "classical_seed": {
          "properties": {
            "n_data": {"$ref": "#/$defs/positive_integer"},
            "K": {"$ref": "#/$defs/positive_integer"},
            "k_logical": {"$ref": "#/$defs/nonnegative_integer"},
            "r_gauge": {"$ref": "#/$defs/nonnegative_integer"}
          }
        },
        "code_family": {},
        "code_instance": {
          "required": ["coding_domain", "n_data", "k_logical"],
          "properties": {
            "construction_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["construction"]},
            "presentation_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["code_presentation"]},
            "distance_claim_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["distance_claim"]},
            "coding_domain": {"enum": ["quantum", null]},
            "n_data": {"$ref": "#/$defs/positive_integer"},
            "K": {"$ref": "#/$defs/positive_integer"},
            "k_logical": {"$ref": "#/$defs/nonnegative_integer"},
            "r_gauge": {"$ref": "#/$defs/nonnegative_integer"}
          }
        },
        "code_mention": {
          "properties": {
            "source_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["paper_version"]},
            "code_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["code_instance"]}
          }
        },
        "code_presentation": {
          "required": ["code_ref", "check_weight_metrics"],
          "properties": {
            "code_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["code_instance"]},
            "construction_recipe_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["construction"]},
            "check_weight_metrics": {"type": ["array", "null"], "items": {"$ref": "#/$defs/weight_metric"}},
            "generator_asset_refs": {"$ref": "#/$defs/nullable_managed_assets", "x-qec-managed-asset": "multiple"}
          },
          "allOf": [
            {
              "if": {
                "required": ["reconstruction_status"],
                "properties": {"reconstruction_status": {"enum": ["complete", "reconstructable"]}}
              },
              "then": {
                "anyOf": [
                  {
                    "required": ["generator_asset_refs"],
                    "properties": {"generator_asset_refs": {"type": "array", "minItems": 1}}
                  },
                  {
                    "required": ["construction_recipe_ref"],
                    "properties": {"construction_recipe_ref": {"$ref": "#/$defs/ref"}}
                  }
                ]
              }
            }
          ]
        },
        "construction": {
          "properties": {"seed_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["classical_seed"]}},
          "allOf": [
            {
              "if": {
                "required": ["reconstruction_status"],
                "properties": {"reconstruction_status": {"enum": ["complete", "reconstructable"]}}
              },
              "then": {
                "required": ["matrix_recipe"],
                "properties": {"matrix_recipe": {"$ref": "#/$defs/complete_matrix_recipe"}}
              }
            }
          ]
        },
        "decoder_configuration": {
          "properties": {
            "algorithm_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["algorithm"]},
            "software_usage_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["software_usage"]}
          }
        },
        "distance_claim": {
          "required": ["subject_ref", "metric_definition_ref", "relation", "lower_bound", "upper_bound"],
          "properties": {
            "subject_ref": {
              "$ref": "#/$defs/nullable_ref",
              "x-qec-target-kinds": ["code_instance", "code_presentation", "circuit_protocol"]
            },
            "metric_definition_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["metric_definition"]},
            "lower_bound": {"$ref": "#/$defs/positive_integer"},
            "upper_bound": {"$ref": "#/$defs/positive_integer"},
            "relation": {"enum": [null, "reported_unspecified", "exact", "lower_bound", "upper_bound", "interval"]}
          },
          "allOf": [
            {
              "if": {
                "properties": {"relation": {"enum": [null, "reported_unspecified"]}},
                "required": ["relation"]
              },
              "then": {"properties": {"lower_bound": {"type": "null"}, "upper_bound": {"type": "null"}}}
            },
            {
              "if": {"properties": {"relation": {"enum": ["exact", "interval"]}}, "required": ["relation"]},
              "then": {
                "properties": {"lower_bound": {"not": {"type": "null"}}, "upper_bound": {"not": {"type": "null"}}}
              }
            },
            {
              "if": {"properties": {"relation": {"enum": ["lower_bound"]}}, "required": ["relation"]},
              "then": {"properties": {"lower_bound": {"not": {"type": "null"}}, "upper_bound": {"type": "null"}}}
            },
            {
              "if": {"properties": {"relation": {"enum": ["upper_bound"]}}, "required": ["relation"]},
              "then": {"properties": {"lower_bound": {"type": "null"}, "upper_bound": {"not": {"type": "null"}}}}
            }
          ]
        },
        "execution_environment": {},
        "execution_run": {
          "required": ["environment_ref", "execution_evidence"],
          "properties": {
            "reported_experiment_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["reported_experiment"]},
            "environment_ref": {"$ref": "#/$defs/ref", "x-qec-target-kinds": ["execution_environment"]},
            "software_usage_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["software_usage"]},
            "execution_asset_refs": {"$ref": "#/$defs/nullable_managed_assets", "x-qec-managed-asset": "multiple"}
          }
        },
        "hardware_assumptions": {},
        "metric_definition": {},
        "noise_instantiation": {
          "required": ["model_ref", "reported_coordinates", "resolved_channel_parameters"],
          "properties": {
            "model_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["noise_model"]},
            "circuit_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["circuit_protocol"]}
          }
        },
        "noise_model": {
          "required": ["idle", "loss", "erasure", "leakage"],
          "properties": {
            "idle": {"$ref": "#/$defs/noise_consideration"},
            "loss": {"$ref": "#/$defs/noise_consideration"},
            "erasure": {"$ref": "#/$defs/noise_consideration"},
            "leakage": {"$ref": "#/$defs/noise_consideration"}
          }
        },
        "paper_version": {
          "properties": {"asset_refs": {"$ref": "#/$defs/nullable_managed_assets", "x-qec-managed-asset": "multiple"}}
        },
        "performance_point": {
          "required": ["experiment_ref", "noise_instantiation_ref", "metric_definition_ref", "value"],
          "properties": {
            "experiment_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["reported_experiment"]},
            "noise_instantiation_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["noise_instantiation"]},
            "metric_definition_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["metric_definition"]},
            "curve_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["performance_series"]},
            "value": {"$ref": "#/$defs/rate"},
            "confidence_interval": {"$ref": "#/$defs/confidence_interval"},
            "shots": {"$ref": "#/$defs/nonnegative_integer"},
            "failures": {"$ref": "#/$defs/nonnegative_integer"},
            "discards": {"$ref": "#/$defs/nonnegative_integer"}
          }
        },
        "performance_series": {
          "properties": {
            "experiment_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["reported_experiment"]},
            "metric_definition_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["metric_definition"]},
            "data_asset_ref": {"$ref": "#/$defs/nullable_managed_asset", "x-qec-managed-asset": "single"}
          }
        },
        "reported_experiment": {
          "required": ["source_ref", "code_ref", "presentation_ref", "circuit_ref", "noise_model_ref", "decoder_ref"],
          "properties": {
            "source_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["paper_version"]},
            "code_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["code_instance"]},
            "presentation_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["code_presentation"]},
            "circuit_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["circuit_protocol"]},
            "noise_model_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["noise_model"]},
            "decoder_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["decoder_configuration"]},
            "hardware_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["hardware_assumptions"]},
            "software_usage_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["software_usage"]},
            "execution_run_refs": {"$ref": "#/$defs/nullable_refs", "x-qec-target-kinds": ["execution_run"]}
          }
        },
        "software_catalog_observation": {
          "properties": {"project_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["software_project"]}}
        },
        "software_distribution": {
          "required": ["project_ref", "ecosystem", "name"],
          "properties": {"project_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["software_project"]}}
        },
        "software_project": {},
        "software_release": {
          "required": ["distribution_ref", "version"],
          "properties": {"distribution_ref": {"$ref": "#/$defs/ref", "x-qec-target-kinds": ["software_distribution"]}}
        },
        "software_usage": {
          "required": ["usage_kind", "project_ref", "release_ref"],
          "properties": {
            "project_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["software_project"]},
            "release_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["software_release"]},
            "source_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["paper_version"]},
            "experiment_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["reported_experiment"]},
            "execution_run_ref": {"$ref": "#/$defs/nullable_ref", "x-qec-target-kinds": ["execution_run"]},
            "usage_kind": {"enum": ["mention", "citation", "source_reported_use", "locally_observed_use"]}
          }
        }
      }
    },
    "nonnegative_integer": {"type": ["integer", "null"], "minimum": 0},
    "positive_integer": {"type": ["integer", "null"], "minimum": 1},
    "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "noise_consideration": {
      "type": ["object", "null"],
      "required": ["consideration"],
      "properties": {"consideration": {"enum": ["included", "excluded"]}}
    },
    "weight_metric": {
      "type": "object",
      "required": ["check_set_id", "sector", "scope"],
      "properties": {
        "check_set_id": {"type": "string", "pattern": "\\S"},
        "sector": {"enum": ["X", "Z", "mixed"]},
        "scope": {"enum": ["stabilizer", "gauge", "measured"]},
        "min": {"$ref": "#/$defs/nonnegative_integer"},
        "max": {"$ref": "#/$defs/nonnegative_integer"},
        "mean": {"type": ["number", "null"], "minimum": 0},
        "histogram": {
          "type": ["object", "null"],
          "propertyNames": {"pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "depth_metric": {
      "type": "object",
      "required": ["kind", "value", "unit", "definition"],
      "properties": {
        "kind": {"enum": ["tick_count", "two_qubit_layers", "operation_layers", "physical_duration"]},
        "definition": {"type": "string", "pattern": "\\S"},
        "value": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["tick_count"]}}, "required": ["kind"]},
          "then": {"properties": {"unit": {"const": "ticks"}, "value": {"type": "integer"}}}
        },
        {
          "if": {
            "properties": {"kind": {"enum": ["two_qubit_layers", "operation_layers"]}},
            "required": ["kind"]
          },
          "then": {"properties": {"unit": {"const": "layers"}, "value": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["physical_duration"]}}, "required": ["kind"]},
          "then": {"properties": {"unit": {"enum": ["s", "ms", "us", "ns", "ps"]}}}
        }
      ]
    },
    "confidence_interval": {
      "type": ["object", "null"],
      "required": ["method", "lower", "upper", "level"],
      "properties": {
        "method": {"type": "string", "pattern": "\\S"},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "managed_asset": {"type": "string", "pattern": "^qecasset:sha256:([0-9a-f]{64})(?![\\s\\S])"},
    "nullable_managed_asset": {"anyOf": [{"$ref": "#/$defs/managed_asset"}, {"type": "null"}]},
    "nullable_managed_assets": {"type": ["array", "null"], "items": {"$ref": "#/$defs/managed_asset"}},
    "complete_matrix_recipe": {
      "description": "A complete recipe specifies the field, shape, indexing, bit order, formula, version and seeds.",
      "type": "object",
      "required": ["field", "index_convention", "bit_order", "formula", "version", "shape", "seed_refs"],
      "properties": {
        "field": {"not": {"type": "null"}},
        "index_convention": {"not": {"type": "null"}},
        "bit_order": {"not": {"type": "null"}},
        "formula": {"not": {"type": "null"}},
        "version": {"not": {"type": "null"}},
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "seed_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "circuit_protocol"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/circuit_protocol"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "classical_seed"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/classical_seed"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "code_instance"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/code_instance"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "code_mention"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/code_mention"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "code_presentation"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/code_presentation"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "construction"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/construction"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "decoder_configuration"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/decoder_configuration"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "distance_claim"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/distance_claim"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "execution_run"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/execution_run"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "noise_instantiation"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/noise_instantiation"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "noise_model"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/noise_model"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "paper_version"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/paper_version"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "performance_point"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/performance_point"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "performance_series"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/performance_series"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "reported_experiment"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/reported_experiment"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "software_catalog_observation"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/software_catalog_observation"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "software_distribution"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/software_distribution"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "software_release"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/software_release"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "software_usage"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/record_data/$defs/software_usage"}}}
    }
  ]
}
