{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "corpus_id",
    "base_registry_revision",
    "actor",
    "rationale",
    "created_at",
    "status",
    "changes",
    "input_bindings"
  ],
  "properties": {
    "schema": {
      "const": "qecgraph.proposal"
    },
    "id": {
      "type": "string",
      "pattern": "^proposal:[0-9a-f]{64}$"
    },
    "corpus_id": {
      "type": "string"
    },
    "base_registry_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "ai",
            "program"
          ]
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "const": "proposed"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after",
          "diff"
        ],
        "properties": {
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": "object"
          },
          "diff": {
            "type": "array"
          }
        }
      }
    },
    "input_bindings": {
      "type": "object",
      "required": [
        "records",
        "source_versions",
        "assets"
      ]
    }
  }
}
