{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qecgraph.local/schema/registry",
  "description": "Current workspace release format.",
  "type": "object",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_range": {
      "type": "object",
      "required": ["path", "char_start", "char_end", "line_start", "line_end"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "structure_binding": {
      "type": "object",
      "required": ["status", "plan_sha256"],
      "properties": {
        "status": {"const": "proposed"},
        "plan_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema": {
      "const": "qecgraph.registry"
    },
    "format_version": {
      "const": 2
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "works": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "project_source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "upstream_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_url": {
            "type": "string",
            "minLength": 1
          },
          "structure_recovery": {"$ref": "#/$defs/structure_binding"}
        },
        "required": [
          "id",
          "work_id",
          "project_id",
          "snapshot_id",
          "project_source_hash",
          "snapshot_path",
          "upstream_version"
        ],
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": ["archived_only", "processing_completed", "needs_entrypoint", "ai_failed", "parse_failed",
                     "damaged_archive", "limit_exceeded", "unsafe_archive", "unsupported_encoding", "unsupported_format"]
          },
          "semantic_status": {"enum": ["not_extracted", "semantic_pending"]},
          "processor": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "source_version_id": {
            "type": "string",
            "minLength": 1
          },
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "normalization_id": {
            "type": "string",
            "minLength": 1
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_tree_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_snapshot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "config_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalization_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalization_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "processing_completed": {
            "type": "boolean"
          },
          "source_version_conflict": {
            "type": "boolean"
          },
          "retained_prior_extraction": {
            "type": "boolean"
          },
          "upstream_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entrypoint_candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["severity", "code", "message", "source"],
              "properties": {
                "severity": {"enum": ["error", "warning", "info"]},
                "code": {"type": "string", "minLength": 1},
                "message": {"type": "string"},
                "source": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/source_range"}]}
              },
              "additionalProperties": false
            }
          },
          "encoding_mappings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["encoding", "original_sha256"],
              "properties": {
                "encoding": {"enum": ["iso-8859-1", "iso-8859-15", "cp1252"]},
                "original_sha256": {"$ref": "#/$defs/sha256"}
              },
              "additionalProperties": false
            }
          },
          "ai_extraction": {
            "type": "object",
            "required": ["status", "written", "errors"],
            "properties": {
              "status": {"enum": ["complete", "pending"]},
              "written": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["skill", "path", "run_id", "proposal_sha256"],
                  "properties": {
                    "skill": {"enum": ["extract_theorems", "extract_assumptions", "extract_data", "extract_thoughts"]},
                    "path": {"type": "string", "minLength": 1},
                    "run_id": {"type": "string", "minLength": 1},
                    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  },
                  "additionalProperties": false
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {"type": "string"},
                    "skill": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1},
                    "char_start": {"type": "integer", "minimum": 0},
                    "char_end": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "structure_recovery": {
            "oneOf": [
              {"$ref": "#/$defs/structure_binding"},
              {
                "type": "object",
                "required": ["status", "reason"],
                "properties": {
                  "status": {"enum": ["ineligible", "unavailable", "pending"]},
                  "reason": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "archive_sha256",
          "status",
          "processing_completed"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "normalization_id": ["normalization_sha256", "normalization_manifest_sha256"],
          "normalization_sha256": ["normalization_id", "normalization_manifest_sha256"],
          "normalization_manifest_sha256": ["normalization_id", "normalization_sha256"]
        },
        "oneOf": [
          {
            "properties": {
              "processing_completed": {"const": true},
              "status": {"const": "processing_completed"}
            },
            "required": [
              "source_version_id",
              "source_snapshot_id",
              "source_tree_hash",
              "entrypoint",
              "work_id"
            ]
          },
          {
            "properties": {
              "processing_completed": {"const": false},
              "status": {"not": {"const": "processing_completed"}}
            }
          }
        ]
      }
    },
    "research_records": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ai_research_records": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "generated_research": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source_snapshot_id", "processor", "bindings", "code_parameters_mentions"],
        "properties": {
          "source_snapshot_id": {"$ref": "#/$defs/sha256"},
          "processor": {"type": "string", "minLength": 1},
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "revision"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "revision": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "code_parameters_mentions": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "retrieval_index": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "stale"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "sha256",
            "corpus_sha256",
            "identity"
          ],
          "not": {
            "required": [
              "status"
            ]
          }
        },
        {
          "required": [
            "status",
            "reason"
          ],
          "not": {
            "required": [
              "sha256"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "format_version",
    "workspace_id",
    "works",
    "versions"
  ],
  "additionalProperties": false
}
