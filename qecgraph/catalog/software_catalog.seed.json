  "verification_policy": {
    "checked": "上游项目身份、公开描述与列出的来源页面",
    "not_checked": [
      "本地安装",
      "功能复现",
      "速度或 LER 宣传数字",
      "全部依赖的许可证",
      "每个发布版本",
      "某篇论文是否实际使用"
    ],
    "version_policy": "本目录不填写最新版本；论文中的实际版本、commit 和配置必须从论文或复现证据另行绑定。",
    "license_policy": "upstream_declared 仅表示官方页面声明；not_verified 的 SPDX 为 null。复用源码或分发前按准确提交重新核对许可证。",
    "alias_policy": "算法名和码族名不是发行包唯一标识；BP-OSD 不自动等同于 bposd 包，LDPC/qLDPC/MWPF 等词需要上下文消歧。aliases 不是已核实的 Python 导入入口表。",
    "network_policy": "此目录不是安装清单；导入论文不自动安装或执行目录中的项目。"
  },
