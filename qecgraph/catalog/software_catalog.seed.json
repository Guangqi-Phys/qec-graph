  "catalogue_scope": {
    "subject": "A starter index of public QEC research software: circuit simulation, decoding, sampling, code construction, visualization and platform frameworks",
    "included_roles": [
      "binary_linear_algebra",
      "circuit_generation",
      "circuit_simulation",
      "code_analysis",
      "code_construction",
      "decoder",
      "dem_generation",
      "experiment_orchestration",
      "qec_framework",
      "qec_platform",
      "sampling",
      "simulation_framework",
      "visualization"
    ],
    "discovery_basis": "Software explicitly named by the user and related projects checked against official repositories, project documentation and maintainer release pages",
    "excluded_from_current_seed": [
      "Undiscovered projects",
      "Paper-specific code whose identity has not been checked",
      "Complete dependency trees of general scientific computing libraries",
      "Closed-source software",
      "Hardware SDKs that have not been checked"
    ]
  },
  "completeness": "non_exhaustive",
  "checked_at": "2026-11-09",
  "verification_policy": {
    "checked": "Upstream project identities, public descriptions and the listed source pages",
    "not_checked": [
      "Local installation",
      "Functional reproduction",
      "Advertised speed or LER figures",
      "Licenses of all dependencies",
      "Every release version",
      "Actual use in a particular paper"
    ],
    "version_policy": "This catalog does not record latest versions. Actual versions, commits and configurations used in a paper require separate bindings to the paper or reproduction evidence.",
    "license_policy": "upstream_declared means only that an official page states the license; SPDX is null for not_verified entries. Recheck licenses at the exact commit before reusing or distributing source.",
    "alias_policy": "Algorithm and code-family names do not uniquely identify distributions. BP-OSD does not automatically mean the bposd package; LDPC/qLDPC/MWPF require contextual disambiguation. aliases is not a verified list of Python import paths.",
    "network_policy": "This catalog is not an installation manifest. Importing papers does not automatically install or execute listed projects."
  },
