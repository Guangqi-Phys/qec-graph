{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "unresolved"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "statement", "hypotheses", "source_refs"],
        "properties": {
          "label": {"type": "string"},
          "statement": {"type": "string"},
          "conclusion": {"type": "string"},
          "proof_label": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "kind", "confidence"],
              "properties": {
                "text": {"type": "string"},
                "kind": {"enum": ["explicit", "implicit"]},
                "reason": {"type": "string"},
                "source_refs": {"type": "array", "items": {"type": "string"}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
