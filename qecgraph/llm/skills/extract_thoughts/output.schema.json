{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "unresolved"
  ],
  "properties": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "published_date", "link", "topics"],
      "properties": {
        "title": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_value"}]},
        "authors": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/evidence_value"}},
        "published_date": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_value"}]},
        "link": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_value"}]},
        "topics": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/evidence_value"}}
      }
    },
    "items": {
      "type": "array",
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "statement",
          "attribution",
          "source_quote",
          "source_refs"
        ],
        "properties": {
          "category": {
            "enum": [
              "problem",
              "motivation",
              "approach",
              "intuition",
              "assumption",
              "conclusion",
              "open_question",
              "surprising_result",
              "side_result"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "A concise English editorial answer retaining all important conditions; use editorial_inference for translation or paraphrase."
          },
          "attribution": {
            "enum": [
              "author_explicit",
              "editorial_inference"
            ]
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 480
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_quote", "source_refs"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "source_quote": {"type": "string", "minLength": 1, "maxLength": 480},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
