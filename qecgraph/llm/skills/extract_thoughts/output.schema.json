{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "unresolved"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "statement",
          "attribution",
          "source_quote",
          "source_refs"
        ],
        "properties": {
          "category": {
            "enum": [
              "problem",
              "motivation",
              "approach",
              "intuition",
              "assumption",
              "conclusion",
              "open_question",
              "surprising_result",
              "side_result"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "enum": [
              "author_explicit",
              "editorial_inference"
            ]
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
